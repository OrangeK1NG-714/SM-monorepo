{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Server: Egg Debug",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "server", "dev", "--", "--inspect-brk"],
      "console": "integratedTerminal",
      "restart": true,
      "autoAttachChildProcesses": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Server: Egg Test",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "server", "test:local", "--", "--inspect-brk"],
      "autoAttachChildProcesses": true
    }
  ]
}
